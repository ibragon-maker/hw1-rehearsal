"9	LINE	0
	#include <iostream>
	#include <iomanip>
	#include "display.h"
	#include "stats.h"
	
	using namespace std;
	
	void printFullReport(const char studentNames[][50], const double scores[][ASSIGNMENT_COUNT], int studentCount, int assignmentCount) {
	    cout << "\n--- FULL GRADEBOOK REPORT ---\n";
	    for (int i = 0; i < studentCount; ++i) {
	        double avg = studentAverage(scores, i, assignmentCount);
	        char grade = letterGrade(avg);
	        cout << left << setw(15) << studentNames[i] << " | Avg: " << fixed << setprecision(2) << setw(6) << avg << " | Grade: " << grade << "\n";
	    }
	}
	
	void printGradeDistribution(const char studentNames[][50], const double scores[][ASSIGNMENT_COUNT], int studentCount, int assignmentCount) {
	    int aCount = 0, bCount = 0, cCount = 0, dCount = 0, fCount = 0;
	    for (int i = 0; i < studentCount; ++i) {
	        char g = letterGrade(studentAverage(scores, i, assignmentCount));
	        if (g == 'A') aCount++;
	        else if (g == 'B') bCount++;
	        else if (g == 'C') cCount++;
	        else if (g == 'D') dCount++;
	        else fCount++;
	    }
	    cout << "\n--- GRADE DISTRIBUTION ---\n";
	    cout << "A: " << aCount << "\nB: " << bCount << "\nC: " << cCount << "\nD: " << dCount << "\nF: " << fCount << "\n";
	}
	
	void printAssignmentAverages(const double scores[][ASSIGNMENT_COUNT], int studentCount, int assignmentCount) {
	    cout << "\n--- ASSIGNMENT AVERAGES ---\n";
	    for (int j = 0; j < assignmentCount; ++j) {
	        double sum = 0.0;
	        for (int i = 0; i < studentCount; ++i) {
	            sum += scores[i][j];
	        }
	        double avg = (studentCount > 0) ? (sum / studentCount) : 0.0;
	        cout << "Assignment " << (j + 1) << ": " << fixed << setprecision(2) << avg << "\n";
	    }
	}
	
	void printRoster(const char studentNames[][50], int studentCount) {
	    cout << "\n--- CLASS ROSTER ---\n";
	    for (int i = 0; i < studentCount; ++i) {
	        cout << (i + 1) << ". " << studentNames[i] << "\n";
	    }
	}
